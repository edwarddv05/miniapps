{
  "expo": {
    "name": "Miniapps",
    "slug": "miniapps",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "miniapps",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mysuperapp.miniapps",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.mysuperapp.miniapps"
        ]
      },
      "infoPlist": {
        "NSPhotoLibraryAddUsageDescription": "La app guarda en Fotos los videos e imágenes que descargas.",
        "NSSupportsLiveActivities": true,
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "La app necesita acceso a tus fotos para escanear y generar tu horario automáticamente."
        }
      ],
      "expo-video",
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "La app usa tu ubicación para mostrarte las estaciones del Metropolitano más cercanas."
        }
      ],
      "expo-secure-store",
      "@bacons/apple-targets",
      "./modules/superapp-native/app.plugin.js"
    ]
  }
}
